# Production Environment Variables for ReleaseSentinel Frontend
# These override .env when running: npm run build
#
# DO NOT commit real secrets here. Set environment variables in Render/Vercel dashboards.

# Your Render backend URL (set this AFTER deploying to Render)
VITE_API_BASE_URL=https://releasesentinel-api.onrender.com

# Gemini API Key — set this in Render / Vercel dashboard environment variables
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
